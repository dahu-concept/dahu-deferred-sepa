msgid "Customer"
msgstr "Client"

#: \includes\gateway.php:105
msgid "Days between the order being marked Completed and the charge being sent. Can be overridden per customer, under Users → the customer → Deferred SEPA Direct Debit."
msgstr "Jours entre le passage de la commande en Terminée et l’envoi du prélèvement. Redéfinissable par client, sous Utilisateurs → le client → Prélèvement SEPA différé."

#: \includes\gateway.php:103
msgid "Default charge delay (days)"
msgstr "Délai de prélèvement par défaut (jours)"

