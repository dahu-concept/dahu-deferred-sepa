msgid "Charge this SEPA mandate now? This takes real money from the customer."
msgstr "Prélever ce mandat SEPA maintenant ? Cela prend réellement de l’argent au client."

#: \dahu-deferred-sepa.php:422
msgid "Charged after shipping"
msgstr "Prélevé après expédition"

#: \dahu-deferred-sepa.php:397
msgid "Charged once"
msgstr "Prélevé une fois"

#: \includes\admin-charges.php:986
msgid "Charges sent by this gateway. Stripe's own immediate SEPA option is not listed here."
msgstr "Prélèvements envoyés par cette passerelle. L’option SEPA immédiate de Stripe n’y figure pas."

#: \dahu-deferred-sepa.php:428
msgid "Charges still to come, with the date each one is sent."
msgstr "Les prélèvements restant à faire, avec la date d'envoi de chacun."

#: \includes\offline.php:63
